# Normalise line endings to LF in the repo and on checkout, so builds and the
# release ZIP are byte-identical regardless of the machine that runs them.
* text=auto eol=lf
*.php text eol=lf
*.txt text eol=lf
*.md  text eol=lf
*.css text eol=lf
*.json text eol=lf

# Keep these out of `git archive` (the release ZIP). Runtime files only ship.
/.gitattributes   export-ignore
/.gitignore       export-ignore
/.github          export-ignore
/.editorconfig    export-ignore
# composer.json IS shipped: Plugin Check flags a bundled /vendor without it.
/README.md        export-ignore
/CREDITS.md       export-ignore
/tests            export-ignore
/build            export-ignore
/dist             export-ignore
